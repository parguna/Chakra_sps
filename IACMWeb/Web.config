<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings file="skin.config">
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
    <add key="Client" value="DEEPIDENTITY" />
    <add key="EnableBundling" value="0" />
    <add key="Authentication" value="IACM Connection" />
    <add key="DbBackupPath" value="D:\IACM\BackUp\DataBase" />
    <add key="LogProviderType" value="DI.Chakra.Logger.DBLogProvider" />
    <add key="LoggerExceptionFile" value="C:\\IACMLog\\LoggerException.log" />
    <add key="DomainApiBaseUrl" value="http://localhost:4427/api/" />
    <add key="ReportApiBaseUrl" value="http://localhost:54428/api/" />
    <add key="DomainServiceBaseUrl" value="http://localhost:8062/service/" />
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5.2" />
      </system.Web>
  -->
  <system.web>
    <httpCookies requireSSL="false" httpOnlyCookies="true" />
    <httpRuntime maxUrlLength="100999" maxRequestLength="2097151" maxQueryStringLength="2097151" executionTimeout="900" requestValidationMode="2.0" />
    <compilation debug="true" targetFramework="4.5.2">
      <assemblies>
        <add assembly="System.DirectoryServices, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.ServiceProcess, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Data.Entity, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="Microsoft.VisualBasic, Version=10.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="PresentationCore, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Speech, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
    <sessionState mode="InProc" timeout="120" />
    <!--<sessionState mode="SQLServer" sqlCommandTimeout="7200" allowCustomSqlDatabase="true"
                    sqlConnectionString="Data Source=(local); Integrated Security=True;" timeout="120" />-->
    <authentication mode="None" />
    <customErrors mode="Off" defaultRedirect="Error.aspx">
      <!--<error statusCode="403" redirect="NoAccess.htm" />
      <error statusCode="404" redirect="FileNotFound.htm" />-->
      <error statusCode="403" redirect="Error.aspx" />
      <error statusCode="404" redirect="Error.aspx" />
      <error statusCode="500" redirect="Error.aspx" />
    </customErrors>
    <httpModules>
      <add name="QueryStringEncyptorModule" type="QueryStringEncyptorModule" />
    </httpModules>
    <httpHandlers>
      <add path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource" verb="*" validate="false" />
      <add verb="*" path="Telerik.Web.UI.DialogHandler.axd" type="Telerik.Web.UI.DialogHandler, Telerik.Web.UI, Culture=neutral, PublicKeyToken=121fae78165ba3d4" />
      <add verb="*" validate="false" path="Telerik.Web.UI.SpellCheckHandler.axd" type="Telerik.Web.UI.SpellCheckHandler, Telerik.Web.UI" />
    </httpHandlers>
    <pages validateRequest="true" enableViewStateMac="true" viewStateEncryptionMode="Always">
      <controls>
        <add tagPrefix="ajaxToolkit" assembly="AjaxControlToolkit" namespace="AjaxControlToolkit" />
      </controls>
    </pages>
  </system.web>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-UA-Compatible" value="IE=edge" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false" />
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="QueryStringEncyptorModule" />
      <remove name="WebDAVModule" />
      <remove name="TRACEVerbHandler" />
      <remove name="ExtensionlessUrl-ISAPI-4.0_32bit" />
      <remove name="ExtensionlessUrl-ISAPI-4.0_64bit" />
      <remove name="ExtensionlessUrl-Integrated-4.0" />
      <add name="QueryStringEncyptorModule" type="QueryStringEncyptorModule" />
    </modules>
    <handlers>
      <add name="Telerik_Web_UI_WebResource_axd" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.WebResource.axd" type="Telerik.Web.UI.WebResource" />
      <add name="Telerik_Web_UI_DialogHandler_aspx" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.DialogHandler.aspx" type="Telerik.Web.UI.DialogHandler" />
      <add name="Telerik_Web_UI_SpellCheckHandler_axd" verb="*" preCondition="integratedMode" path="Telerik.Web.UI.SpellCheckHandler.axd" type="Telerik.Web.UI.SpellCheckHandler" />
      <!--<remove name="WebDAV"/>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
      <remove name="OPTIONSVerbHandler"/>
      <remove name="QueryStringEncyptorModule"/>
      <remove name="TRACEVerbHandler"/>
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*" verb="*" type="System.Web.Handlers.TransferRequestHandler"/>-->
    </handlers>
    <security>
      <requestFiltering allowHighBitCharacters="false">
        <requestLimits maxAllowedContentLength="2147483648" maxQueryString="99983648" />
        <fileExtensions allowUnlisted="false">
          <remove fileExtension="." />
          <add fileExtension="." allowed="true" />
          <add fileExtension=".aspx" allowed="true" />
          <add fileExtension=".jpg" allowed="true" />
          <add fileExtension=".jpeg" allowed="true" />
          <add fileExtension=".png" allowed="true" />
          <add fileExtension=".css" allowed="true" />
          <add fileExtension=".js" allowed="true" />
          <add fileExtension=".gif" allowed="true" />
          <add fileExtension=".pdf" allowed="true" />
          <add fileExtension=".xls" allowed="true" />
          <add fileExtension=".xlsx" allowed="true" />
          <add fileExtension=".bmp" allowed="true" />
          <add fileExtension=".htm" allowed="true" />
          <add fileExtension=".html" allowed="true" />
          <add fileExtension=".ico" allowed="true" />
          <add fileExtension=".axd" allowed="true" />
          <add fileExtension=".xamlx" allowed="true" />
          <add fileExtension=".csv" allowed="true" />
          <add fileExtension=".svc" allowed="true" />
          <add fileExtension=".ttf" allowed="true" />
          <add fileExtension=".woff" allowed="true" />
          <add fileExtension=".woff2" allowed="true" />
        </fileExtensions>
        <verbs allowUnlisted="false">
          <add verb="GET" allowed="true" />
          <add verb="OPTION" allowed="true" />
          <add verb="POST" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="PUT" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
  </system.webServer>
  <system.serviceModel>
    <!-- HTTPS endpoints using this binding are added by Web.Release.config (local IIS Express runs HTTP only) -->
    <bindings>
      <webHttpBinding>
        <binding name="webHttpsBinding">
          <security mode="Transport" />
        </binding>
      </webHttpBinding>
    </bindings>
    <behaviors>
      <endpointBehaviors>
        <behavior name="AutoCompleteDataEndPointBehavior">
          <enableWebScript />
        </behavior>
        <behavior name="AttestationEndPointBehavior">
          <webHttp />
        </behavior>
      </endpointBehaviors>
      <serviceBehaviors>
        <behavior name="AutoCompleteDataServiceBehavior">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
        <behavior name="AttestationDataServiceBehavior">
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
    <services>
      <service name="DI.Chakra.Web.Services.AutoCompleteDataService" behaviorConfiguration="AutoCompleteDataServiceBehavior">
        <endpoint address="" behaviorConfiguration="AutoCompleteDataEndPointBehavior" binding="webHttpBinding" contract="DI.Chakra.Web.Services.IAutoCompleteDataService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
      <service name="DI.Chakra.Web.Services.AttestationDataService" behaviorConfiguration="AttestationDataServiceBehavior">
        <endpoint address="" behaviorConfiguration="AttestationEndPointBehavior" binding="webHttpBinding" contract="DI.Chakra.Web.Services.IAttestationDataService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
  </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework.MappingAPI" publicKeyToken="7ee2e825d201459e" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.1.0.9" newVersion="6.1.0.9" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.5.2.14234" newVersion="1.5.2.14234" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>