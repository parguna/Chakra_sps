<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,Log4net" />
  </configSections>
  <appSettings>
    <add key="Connection" value="Local" />
    <add key="AttestationTimerIntervalInMinutes" value="2" />
    <add key="LogProviderType" value="DI.Chakra.Logger.DBLogProvider" />
    <add key="LoggerExceptionFile" value="C:\\IACMLog\\LoggerException.log" />
  </appSettings>
  <connectionStrings configSource="ConnectionString.config"></connectionStrings>
  <log4net>
    <appender type="log4net.Appender.RollingFileAppender" name="Scheduler">
      <file value="C:\\IACMIntLog\\Scheduler.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionpattern value="%d [%t] %-5p %c - %m%n" />
      </layout>
    </appender>
    <appender type="log4net.Appender.RollingFileAppender" name="Discovery">
      <file value="C:\\IACMIntLog\\Discovery.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionpattern value="%d [%t] %-5p %c - %m%n" />
      </layout>
    </appender>
    <appender type="log4net.Appender.RollingFileAppender" name="General">
      <file value="C:\\IACMIntLog\\General.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-2p %c [%x] - %m%n" />
      </layout>
    </appender>
    <appender type="log4net.Appender.RollingFileAppender" name="Attestation">
      <file value="C:\\IACMIntLog\\Attestation.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-2p %c [%x] - %m%n" />
      </layout>
    </appender>
    <appender type="log4net.Appender.RollingFileAppender" name="Workflow">
      <file value="C:\\IACMIntLog\\Workflow.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-2p %c [%x] - %m%n" />
      </layout>
    </appender>
    <appender type="log4net.Appender.RollingFileAppender" name="Provisioning">
      <file value="C:\\IACMIntLog\\Provisioning.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionpattern value="%d [%t] %-5p %c - %m%n" />
      </layout>
    </appender>
    <appender name="Email" type="log4net.Appender.SmtpAppender">
      <to value="wasim@deepidentity.com" />
      <from value="noreply@senokoenergy.com" />
      <subject value="Alert:IDAMS Scheduler" />
      <smtpHost value="10.2.8.200" />
      <bufferSize value="512" />
      <port value="25" />
      <lossy value="false" />
      <evaluator type="log4net.Core.LevelEvaluator">
        <threshold value="INFO" />
      </evaluator>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%m" />
      </layout>
    </appender>
    <logger name="Provisioning">
      <level value="INFO" />
      <appender-ref ref="Provisioning" />
    </logger>
    <logger name="Scheduler">
      <level value="INFO" />
      <appender-ref ref="Scheduler" />
    </logger>
    <logger name="Discovery">
      <level value="INFO" />
      <appender-ref ref="Discovery" />
    </logger>
    <logger name="General">
      <level value="INFO" />
      <appender-ref ref="General" />
    </logger>
    <logger name="Attestation">
      <level value="INFO" />
      <appender-ref ref="Attestation" />
    </logger>
    <logger name="Workflow">
      <level value="INFO" />
      <appender-ref ref="Workflow" />
    </logger>
    <logger name="Email">
      <level value="INFO" />
      <appender-ref ref="Email" />
    </logger>
    <root>
      <level value="Info" />
      <!--<appender-ref ref="FileAppender"/>-->
    </root>
  </log4net>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager enabled="true" defaultProvider="ClientRoleProvider">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>
  <system.serviceModel>
    <bindings>
      <wsHttpBinding>
        <binding name="WSHttpBinding_IWFService" receiveTimeout="00:30:00" sendTimeout="00:30:00" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647">
          <security mode="None" />
        </binding>
      </wsHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:53412/Attestation/AttestationApprovalWFService.xamlx" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IWFService" contract="AttestationApprovalWFServiceReference.IWFService" name="WSHttpBinding_IWFService" />
    </client>
  </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework" publicKeyToken="b77a5c561934e089" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework.MappingAPI" publicKeyToken="7ee2e825d201459e" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.1.0.9" newVersion="6.1.0.9" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
