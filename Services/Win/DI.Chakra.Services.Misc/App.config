<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
  </startup>

  <appSettings>
    <add key="Connection" value="Local" />
    <add key="MiscellaneousTimerIntervalInMinutes" value="1440" />
    <add key="WakeupWorkflowTimerIntervalInMinutes" value="60" />
    <add key="WakeupServiceTimerIntervalInMinutes" value="15" />
    <add key="HealthCheckServiceTimerIntervalInMinutes" value="60" />
    <add key="LogProviderType" value="DI.Chakra.Logger.DBLogProvider" />
    <add key="LoggerExceptionFile" value="C:\\IACMLog\\LoggerException.log" />
    <add key="WFService" value="http://localhost:53412/Attestation/AttestationApprovalWFService.xamlx|http://localhost:53412/Provisioning/ProvisioningApprovalWFService.xamlx" />
    <add key="ExpiredRequestEmailNotificationDays" value="3" />
    <add key="AutoDeprovisionExpireAccessRequest" value="false" />
  </appSettings>
  <connectionStrings configSource="ConnectionString.config"></connectionStrings>
  <system.serviceModel>
    <bindings>
      <wsHttpBinding>
        <binding name="WSHttpBinding_IWFService" receiveTimeout="00:30:00" sendTimeout="00:30:00" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647">
          <security mode="None" />
        </binding>
      </wsHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:53412/Attestation/AttestationApprovalWFService.xamlx" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IWFService" contract="AttestationApprovalWFServiceReference.IWFService" name="WSHttpBinding_IWFService" />
    </client>
  </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="EntityFramework.MappingAPI" publicKeyToken="7ee2e825d201459e" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.1.0.9" newVersion="6.1.0.9" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
