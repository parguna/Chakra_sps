<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,Log4net" />
  </configSections>

  <connectionStrings configSource="ConnectionString.config"></connectionStrings>

  <appSettings>
    <add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
    <add key="Connection" value="Local" />
    <add key="LogProviderType" value="DI.Chakra.Logger.DBLogProvider" />
  </appSettings>
  <system.web>
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.5">
    </compilation>
    <httpRuntime targetFramework="4.5" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
  </system.web>
  <system.serviceModel>
    <bindings>
      <wsHttpBinding>
        <binding name="CustomLargeSettings" maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647">
          <security mode="None" />
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
        </binding>
      </wsHttpBinding>
    </bindings>

    <services>
      <!--Attestation-->
      <service name="AttestationApprovalWFService">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="CustomLargeSettings" contract="IWFService">
        </endpoint>
      </service>

      <!--Provisioning-->
      <service name="ProvisioningApprovalWFService">
        <endpoint address="" binding="wsHttpBinding" bindingConfiguration="CustomLargeSettings" contract="IWFService"></endpoint>
      </service>
    </services>

    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- To avoid disclosing metadata information, set the values below to false before deployment -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <!-- To receive exception details in faults for debugging purposes, set the value below to true.  Set to false before deployment to avoid disclosing exception information -->
          <serviceDebug includeExceptionDetailInFaults="false" />
          <!--Set up SQL Instance Store-->
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
          <!--<sqlWorkflowInstanceStore connectionString="Data Source=didmdb01; Initial Catalog=WorkflowInstanceStore; Persist Security Info= True;User ID=idmsuser;Password=Pass1234;Connect Timeout=1000;Asynchronous Processing=True"
                  hostLockRenewalPeriod="00:00:15" runnableInstancesDetectionPeriod="00:00:05" />-->
          <sqlWorkflowInstanceStore connectionString="Data Source=.;Initial Catalog=WorkflowInstanceStoreEBS;User ID=sa;Password=P@ssw0rd;Asynchronous Processing=True" hostLockRenewalPeriod="00:00:15" runnableInstancesDetectionPeriod="00:00:05" />

          <workflowIdle timeToPersist="00:00:00" timeToUnload="00:00:05" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <!--<protocolMapping>
      <add binding="basicHttpsBinding" scheme="https" />
    </protocolMapping>-->
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
        <directoryBrowse enabled="false" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <log4net>

    <appender type="log4net.Appender.RollingFileAppender" name="UIAuditLog">
      <file value="C:\\IACMLog\\UIAuditLog.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-2p %c [%x] - %m%n" />
      </layout>
    </appender>
    <appender type="log4net.Appender.RollingFileAppender" name="UIErrorLog">
      <file value="C:\\IACMLog\\UIErrorLog.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-2p %c [%x] - %m%n" />
      </layout>
    </appender>
    <appender type="log4net.Appender.RollingFileAppender" name="Attestation">
      <file value="C:\\IACMIntLog\\Attestation.log" />
      <rollingStyle value="Date" />
      <param name="AppendToFile" value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%d [%t] %-2p %c [%x] - %m%n" />
      </layout>
    </appender>

    <logger name="UIAuditLog">
      <level value="INFO" />
      <appender-ref ref="UIAuditLog" />
    </logger>
    <logger name="UIErrorLog">
      <level value="INFO" />
      <appender-ref ref="UIErrorLog" />
    </logger>
    <logger name="Attestation">
      <level value="INFO" />
      <appender-ref ref="Attestation" />
    </logger>
    <root>
      <level value="Info" />
      <!--<appender-ref ref="FileAppender"/>-->
    </root>
  </log4net>
  <system.diagnostics>
    <sources>
      <source name="System.Activities.DurableInstancing" switchValue="Verbose">
        <listeners>
          <add name="textListener" />
          <remove name="Default" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="textListener" type="System.Diagnostics.TextWriterTraceListener" initializeData="c:\Log\persistenceproblem.txt" traceOutputOptions="ProcessId, DateTime" />
    </sharedListeners>
    <trace autoflush="true" indentsize="4">
      <listeners>
        <add name="textListener" />
      </listeners>
    </trace>
  </system.diagnostics>

  <runtime>

    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

      <dependentAssembly>

        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />

      </dependentAssembly>

      <dependentAssembly>

        <assemblyIdentity name="EntityFramework.MappingAPI" publicKeyToken="7ee2e825d201459e" culture="neutral" />

        <bindingRedirect oldVersion="0.0.0.0-6.1.0.9" newVersion="6.1.0.9" />

      </dependentAssembly>

    </assemblyBinding>

  </runtime>
</configuration>
