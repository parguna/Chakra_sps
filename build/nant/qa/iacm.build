  <target name="buildReportingService" description="Build the Reporting service">
    <exec program="${MSBuildPath}">
      <arg line="${build.ReportingServiceprojDir}DI.Chakra.Services.Reporting.csproj" />
      <arg line="/p:Configuration=Release" />
      <arg value="/target:Rebuild" />
      <arg value="/p:outdir=${build.ReportingServiceprojDir}bin\Release\" />
    </exec>
  </target>
  
  <target name="deployTempWeb" description="Copy built files">
    <copy todir="${build.deployTempRootDir}">
      <fileset basedir="${build.webprojDir}bin\_PublishedWebsites\DI.Chakra.Web">
        <include name="**" />
        <exclude name="web.config"/>
        <exclude name="Web.Debug.**"/>
        <exclude name="Web.Release.**"/>
        <exclude name="**.pdb"/>
      </fileset>
    </copy>

    <attrib normal="true">
      <fileset basedir="${build.deployTempRootDir}">
        <include name="**"/>
      </fileset>
    </attrib>

    <attrib readonly="false">
      <fileset basedir="${build.deployTempRootDir}">
        <include name="**"/>
      </fileset>
    </attrib>
  </target>

  <target name="deployTempDomainApi" description="Copy built files">
