      <arg line="${build.ComplianceServiceprojDir}DI.Chakra.Services.Compliance.csproj" />
      <arg line="/p:Configuration=Release" />
      <arg value="/target:Rebuild" />
      <arg value="/p:outdir=${build.ComplianceServiceprojDir}bin\Release\" />
    </exec>
