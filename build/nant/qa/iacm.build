      </fileset>
    </copy>
  </target>
  <target name="copyDomainApiConfig" description="Copy config files">
    <copy todir="${build.deployDomainApiRootDir}" overwrite="true">
      <fileset basedir="${build.deployconfigDomainApidir}">
        <include name="**"/>
      </fileset>
    </copy>
  </target>
    <target name="copyDomainServiceConfig" description="Copy config files">
      <copy todir="${build.deployRootDomainServiceDir}" overwrite="true">
        <fileset basedir="${build.deployconfigDomainServicedir}">
          <include name="**"/>
        </fileset>
      </copy>

    </target>
    <target name="copyWfConfig" description="Copy config files">
