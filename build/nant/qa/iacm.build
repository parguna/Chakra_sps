<?xml version="1.0" encoding="utf-8"?>
<project name="iacm" default="int">
  <property name="build.phase" value="Phase1" />
  <property name="MSBuildPath" value="C:\WINDOWS\Microsoft.NET\Framework\v4.0.30319\MSBuild.exe"/>
  <property name="build.client" value="DEEPIDENTITY" />
  <property name="build.sourcedir" value="C:\IACM\Source\4e058435cc04ef19\" />
  <property name="build.solutiondir" value="${build.sourcedir}Solution\" />
  <property name="build.webprojDir" value="${build.sourcedir}IACMWeb\" />
  <property name="build.domainApiprojDir" value="${build.sourcedir}DI.Chakra.DomainApi\" />
  <property name="build.domainServiceprojDir" value="${build.sourcedir}DI.Chakra.DomainService\" />
  <property name="build.wfprojDir" value="${build.sourcedir}Workflows\DI.Chakra.Workflow.Services\" />

  <property name="build.AttestationServiceprojDir" value="${build.sourcedir}Services\Win\DI.Chakra.Services.Attestation\" />
  <property name="build.DiscoveryServiceprojDir" value="${build.sourcedir}Services\Win\DI.Chakra.Services.Discovery\" />
  <property name="build.EmailingServiceprojDir" value="${build.sourcedir}Services\Win\DI.Chakra.Services.Emailing\" />
  <property name="build.ProvisioningServiceprojDir" value="${build.sourcedir}Services\Win\DI.Chakra.Services.Provisioning\" />
  <property name="build.MiscServiceprojDir" value="${build.sourcedir}Services\Win\DI.Chakra.Services.Misc\" />
  <property name="build.ComplianceServiceprojDir" value="${build.sourcedir}Services\Win\DI.Chakra.Services.Compliance\" />
  <property name="build.ReportingServiceprojDir" value="${build.sourcedir}Services\Win\DI.Chakra.Services.Reporting\" />
  
  
  <property name="properties.devfile" value="${build.sourcedir}build\nant\qa\dev.xml" />

  <tstamp>
    <formatter property="build.date" pattern="yyyyMMdd"/>
    <formatter property="build.time" pattern="hh.mm.ss" />
  </tstamp>

  <target name="dev" description="Build solution and copy dev files">
    <property name="environmentfile" value="${properties.devfile}"/>
    <call target="build"/>
  </target>

  <target name="build">
    
    <call target="importProperties" cascade="false"/>
    
    <call target="cleantemp"/>
    
    <call target="buildweb"/>
    <call target="buildDomainApi"/>
    <call target="buildDomainService"/>
    <call target="buildWf"/>

    <call target="buildAttestationService"/>
    <call target="buildDiscoveryService"/>
    <call target="buildEmailingService"/>
    <call target="buildProvisioningService"/>
    <call target="buildMiscService"/>
    <call target="buildComplianceService"/>
    <call target="buildReportingService"/>
    
    <call target="deployTempWeb"/>
    <call target="deployTempDomainApi"/>
    <call target="deployTempDomainService"/>
    <call target="deployTempWf"/>
    <call target="deployTempAttestationService"/>
    <call target="deployTempDiscoveryService"/>
    <call target="deployTempEmailingService"/>
    <call target="deployTempProvisioningService"/>
    <call target="deployTempMiscService"/>
    <call target="deployTempComplianceService"/>
    <call target="deployTempReportingService"/>
    
    <trycatch>
      <try>
        <call target="UninstallAttestationService"/>
      </try>
      <catch></catch>
    </trycatch>
    <trycatch>
      <try>
        <call target="UninstallDiscoveryService"/>
      </try>
      <catch></catch>
    </trycatch>
    <trycatch>
      <try>
        <call target="UninstallEmailingService"/>
      </try>
      <catch></catch>
    </trycatch>
    <trycatch>
      <try>
        <call target="UninstallProvisioningService"/>
      </try>
      <catch></catch>
    </trycatch>
    <trycatch>
      <try>
        <call target="UninstallMiscService"/>
      </try>
      <catch></catch>
    </trycatch>
    <trycatch>
      <try>
        <call target="UninstallComplianceService"/>
      </try>
      <catch></catch>
    </trycatch>
    <trycatch>
      <try>
        <call target="UninstallReportingService"/>
      </try>
      <catch></catch>
    </trycatch>
    
    <call target="cleanroot"/>

    <call target="deployWeb"/>
    <call target="deployDomainApi"/>
    <call target="deployDomainService"/>
    <call target="deployWf"/>

    <call target="deployAttestation"/>
    <call target="deployDiscovery"/>
    <call target="deployEmailing"/>
    <call target="deployProvisioning"/>
    <call target="deployMisc"/>
    <call target="deployCompliance"/>
    <call target="deployReporting"/>
    
    <call target="copyWebConfig"/>
    <call target="copyDomainApiConfig"/>
    <call target="copyDomainServiceConfig"/>
    <call target="copyWfConfig"/>
    
    <call target="copyAttestationConfig"/>
    <call target="copyDiscoveryConfig"/>
    <call target="copyEmailingConfig"/>
    <call target="copyProvisioningConfig"/>
    <call target="copyMiscConfig"/>
    <call target="copyComplianceConfig"/>
    <call target="copyReportingConfig"/>

    <call target="InstallAttestationService"/>
    <call target="InstallDiscoveryService"/>
    <call target="InstallEmailingService"/>
    <call target="InstallProvisioningService"/>
    <call target="InstallMiscService"/>
    <call target="InstallComplianceService"/>
    <call target="InstallReportingService"/>
       
  </target>

  <target name="importProperties">
    <property name="propertiesFile" value="${environmentfile}"/>
    <if test="${file::exists(propertiesFile)}">
      <include buildfile="${propertiesFile}"/>
    </if>
    <if test="${not file::exists(propertiesFile)}">
      <fail message="Properties file ${propertiesFile} could not be found."/>
    </if>
  </target>


  <target name="cleantemp" description="Clean deploy folder">
    <delete dir="${build.deployTempRootDir}"/>
    <delete dir="${build.deployTempDomainApiRootDir}"/>
    <delete dir="${build.deployTempDomainServiceRootDir}"/>
    <delete dir="${build.deployTempWfRootDir}"/>
    <delete dir="${build.deployTempAttestationServiceRootDir}"/>
    <delete dir="${build.deployTempDiscoveryServiceRootDir}"/>
    <delete dir="${build.deployTempEmailingServiceRootDir}"/>
    <delete dir="${build.deployTempProvisioningServiceRootDir}"/>
    <delete dir="${build.deployTempMiscServiceRootDir}"/>
    <delete dir="${build.deployTempComplianceServiceRootDir}"/>
    <delete dir="${build.deployTempReportingServiceRootDir}"/>
  </target>

  <target name="UninstallAttestationService" description="Uninstall Attestation Service">
    <exec program="${build.deployAttestationService}\UNinstall_attestationService.bat">
    </exec>
  </target>
  <target name="UninstallDiscoveryService" description="Uninstall Discovery Service">
    <exec program="${build.deployDiscoveryService}\UNinstall_discoveryService.bat">
    </exec>
  </target>
  <target name="UninstallEmailingService" description="Uninstall Emailing Service">
    <exec program="${build.deployEmailingService}\UNinstall_emailingService.bat">
    </exec>
  </target>
  <target name="UninstallProvisioningService" description="Uninstall Provisioning Service">
    <exec program="${build.deployProvisioningService}\UNinstall_provisioningService.bat">
    </exec>
  </target>
  <target name="UninstallMiscService" description="Uninstall Misc Service">
    <exec program="${build.deployMiscService}\Uninstall_MiscService.bat">
    </exec>
  </target>
  <target name="UninstallComplianceService" description="Uninstall Compliance Service">
    <exec program="${build.deployComplianceService}\UNinstall_complianceService.bat">
    </exec>
  </target>
  <target name="UninstallReportingService" description="Uninstall Reporting Service">
    <exec program="${build.deployReportingService}\UninstallReportService.bat">
    </exec>
  </target>
  
  <target name="cleanroot" description="Clean deploy folder">
    <delete dir="${build.deployRootDir}\"/>
    <delete dir="${build.deployDomainApiRootDir}\"/>
    <delete dir="${build.deployRootDomainServiceDir}\"/>
    <delete dir="${build.deployRootWfDir}\"/>
    <delete dir="${build.deployAttestationService}"/>
    <delete dir="${build.deployDiscoveryService}"/>
    <delete dir="${build.deployEmailingService}"/>
    <delete dir="${build.deployProvisioningService}"/>
    <delete dir="${build.deployMiscService}"/>
    <delete dir="${build.deployComplianceService}"/>
    <delete dir="${build.deployReportingService}"/>
  </target>

  <target name="buildweb" description="Build the solution">
    <exec program="${MSBuildPath}">
      <arg line="${build.webprojDir}DI.Chakra.Web.csproj" />
      <arg line="/p:Configuration=Release" />
      <arg value="/target:Rebuild" />
      <arg value="/p:outdir=${build.webprojDir}bin\" />
    </exec>
  </target>
  <target name="buildDomainApi" description="Build the solution">
    <exec program="${MSBuildPath}">
      <arg line="${build.domainApiprojDir}DI.Chakra.DomainApi.csproj" />
      <arg line="/p:Configuration=Release" />
      <arg value="/target:Rebuild" />
      <arg value="/p:outdir=${build.domainApiprojDir}bin\" />
    </exec>
  </target>
  <target name="buildDomainService" description="Build the domain service">
    <exec program="${MSBuildPath}">
      <arg line="${build.domainServiceprojDir}DI.Chakra.DomainService.csproj" />
      <arg line="/p:Configuration=Release" />
      <arg value="/target:Rebuild" />
      <arg value="/p:outdir=${build.domainServiceprojDir}bin\" />
    </exec>
  </target>
  <target name="buildWf" description="Build the Workflow service">
