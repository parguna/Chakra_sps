        <exclude name="Web.Release.**"/>
        <exclude name="**.pdb"/>
        <exclude name="ConnectionString.config"/>
      </fileset>
    </copy>

    <attrib normal="true">
      <fileset basedir="${build.deployTempDomainApiRootDir}">
