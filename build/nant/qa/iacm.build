  <target name="stopAppPool" description="Stop Application Pool">

    <loadtasks assembly="C:\TeamCity\buildAgent\nant\nantcontrib\bin\NAnt.Contrib.Tasks.dll" />

    <iisapppool action="Stop" pool="Test" server="192.168.15.76" />
  </target>

  <target name="deployWeb" description="Copy built files">
    <copy todir="${build.deployRootDir}">
      <fileset basedir="${build.deployTempRootDir}">
        <include name="**.*"/>
      </fileset>
    </copy>
  </target>

  <target name="deployDomainApi" description="Copy built files">
