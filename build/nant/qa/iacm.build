      <fileset basedir="${build.domainServiceprojDir}bin\_PublishedWebsites\DI.Chakra.DomainService">
        <include name="**" />
        <exclude name="web.config"/>
        <exclude name="Web.Debug.**"/>
        <exclude name="Web.Release.**"/>
        <exclude name="**.pdb"/>
